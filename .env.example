# Optional overrides for Frameforge (backend / MCP / tooling).
# Copy to .env if you load env files locally — most vars also work via shell or MCP config.

# ComfyUI HTTP API (default: http://127.0.0.1:8000)
# COMFY_LOCAL_URL=http://127.0.0.1:8000

# Path to comfy-cli binary if not on PATH (Windows example)
# COMFY_BIN=C:\path\to\comfy.exe

# ffmpeg if not on PATH
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# MCP server → REST API
FRAMEFORGE_URL=http://127.0.0.1:8787

# Unity install targets for MCP tools install_to_unity / install_item_to_unity
# UNITY_PROJECT_ROOT=C:\path\to\YourUnityProject
# UNITY_ASSETS_SUBDIR=Assets/Creatures/spritesheets
# UNITY_ITEMS_ASSETS_SUBDIR=Assets/Items/spritesheets
